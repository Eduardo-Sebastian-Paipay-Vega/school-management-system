NODE_ENV=development
PORT=3001

# Base de Datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=sms_runtime
DB_PASSWORD=REEMPLAZAR_CON_CLAVE_ALEATORIA_DE_24_CARACTERES_O_MAS
DB_NAME=school_management

# Motor de Caché y Sesiones Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Criptografía y JWT (RF-01)
JWT_SECRET=super_secret_jwt_key_unsch_2026_school_management_system_change_in_prod
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_unsch_2026_change_in_prod
JWT_REFRESH_EXPIRES_IN=7d

# Clave Maestra de Cifrado en Reposo (RF-68, Ley 29733) — 32 bytes hex para AES-256
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
DOCUMENT_HMAC_KEY=REEMPLAZAR_CON_64_DIGITOS_HEXADECIMALES_ALEATORIOS

# Correo transaccional para activación, recuperación y avisos
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
