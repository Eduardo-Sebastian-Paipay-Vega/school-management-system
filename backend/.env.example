NODE_ENV=development
PORT=3000

# Base de Datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgrespassword2026!
DB_NAME=school_management

# Motor de Caché y Sesiones Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Criptografía y JWT (RF-01)
JWT_SECRET=super_secret_jwt_key_unsch_2026_school_management_system_change_in_prod
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_unsch_2026_change_in_prod
JWT_REFRESH_EXPIRES_IN=7d

# Clave Maestra de Cifrado en Reposo (RF-68, Ley 29733) — 32 bytes hex para AES-256
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# CORS & Frontend Origins
CORS_ORIGIN=http://localhost:8000,http://localhost:3000,https://*.vercel.app
