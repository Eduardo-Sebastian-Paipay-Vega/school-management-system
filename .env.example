# Variables de docker-compose.yml para el entorno local de desarrollo.
# Copie este archivo como `.env` en la raíz y reemplace el valor; `.env` está en .gitignore.
# docker compose se niega a iniciar PostgreSQL si POSTGRES_PASSWORD no está definida.
POSTGRES_PASSWORD=REEMPLAZAR_CON_UNA_CONTRASENA_LOCAL_LARGA
