{
  "$schema": "https://json.schemastore.org/design-tokens",
  "version": "1.0.0",
  "name": "GuamanPomaLandingTokens",
  "colors": {
    "paper": {
      "lightest": { "value": "#FFFCF8", "role": "Fondo principal de página (.bbd-page)" },
      "lighter": { "value": "#FFF7F3", "role": "Fondos secundarios y superficies suaves" },
      "light": { "value": "#F5EBE8", "role": "Hover de enlaces en navbar y listas" },
      "normal": { "value": "#E8D8D4", "role": "Bordes de tarjetas y separadores sutiles" },
      "dark": { "value": "#B5A29E", "role": "Bordes secundarios y botones inactivos" },
      "darker": { "value": "#796763", "role": "Texto secundario y metadatos de tarjetas" },
      "darkest": { "value": "#241719", "role": "Texto de máxima jerarquía sobre fondos claros" },
      "ink": { "value": "#291719", "role": "Texto del menú de navegación y titulares oscuros" },
      "shade80": { "value": "rgba(41, 23, 25, 0.80)", "role": "Color de lectura de párrafos corporativos" }
    },
    "burgundy": {
      "darkest": { "value": "#290006", "role": "Texto de alto contraste sobre superficies pastel" },
      "darker": { "value": "#3A0008", "role": "Titulares H1/H2, background del footer y drawer" },
      "dark": { "value": "#4F000B", "role": "Color institucional principal UNSCH / Banners" },
      "normal": { "value": "#8F1025", "role": "Botones primarios (.bbd-btn variant='purple')" },
      "light": { "value": "#C32942", "role": "Tarjetas destacadas, acentos y pills de hero" },
      "lighter": { "value": "#E64B63", "role": "Resaltados en titulares y enlaces activos" },
      "lightest": { "value": "#F47788", "role": "Wordmark vectorial monumental y decoraciones" },
      "pastel1": { "value": "#F9A7B1", "role": "Tarjetas Bento (.is--1) y tarjetas de contacto footer" },
      "pastel2": { "value": "#FCE0E4", "role": "Pills de subtítulos y fondos suaves de acento" },
      "statsBg": { "value": "#FFF0F2", "role": "Fondo de transición en sección de estadísticas" }
    },
    "gold": {
      "darkest": { "value": "#4A3008", "role": "Texto sobre fondos dorados pastel" },
      "darker": { "value": "#79500D", "role": "Títulos en secciones de excelencia" },
      "dark": { "value": "#A87515", "role": "Acentos institucionales" },
      "normal": { "value": "#D49A22", "role": "Indicadores y métricas protagonistas" },
      "light": { "value": "#E5B342", "role": "Bordes de tarjetas destacadas" },
      "pastel": { "value": "#FFF5DC", "role": "Pill de excelencia y plan 2027 en Hero" }
    },
    "blue": {
      "darkest": { "value": "#103354", "role": "Sombra y acento en tarjetas académicas" },
      "darker": { "value": "#17466F", "role": "Pill de talento en conductores de enfoque" },
      "normal": { "value": "#2878B9", "role": "Elementos académicos" },
      "light": { "value": "#5099D5", "role": "Fondo tarjeta Bento del Plan (.is--2)" },
      "pastel": { "value": "#E7F3FC", "role": "Texto y etiquetas sobre fondos azules" }
    },
    "orange": {
      "darkest": { "value": "#54230C", "role": "Texto en botones de variante naranja" },
      "darker": { "value": "#803711", "role": "Pill de ciencia experimental" },
      "normal": { "value": "#D96522", "role": "Números gigantes y estadísticas de innovación" },
      "light": { "value": "#ED7B32", "role": "Conductor de ciencia y tarjetas de dinamismo" },
      "pastel": { "value": "#FFF0E5", "role": "Subtarjetas y fondos de indicadores" }
    },
    "green": {
      "darkest": { "value": "#16432B", "role": "Texto sobre fondos verdes pastel" },
      "darker": { "value": "#1E5938", "role": "Acentos de sostenibilidad" },
      "normal": { "value": "#32965C", "role": "Botones de variante verde y tarjetas de desarrollo" },
      "pastel": { "value": "#EAF8EE", "role": "Pill de crecimiento y transición curva del footer" }
    }
  },
  "typography": {
    "display": {
      "fontFamily": "Roboto Condensed, Impact, sans-serif",
      "fontWeight": "900",
      "letterSpacing": "-0.025em",
      "textTransform": "uppercase"
    },
    "body": {
      "fontFamily": "Roboto, Arial, sans-serif",
      "fontWeight": "300",
      "lineHeight": "1.5"
    },
    "scales": {
      "h1": {
        "desktop": { "fontSize": "104px", "lineHeight": "1.00" },
        "laptop": { "fontSize": "66.56px", "lineHeight": "1.00" },
        "tablet": { "fontSize": "72px", "lineHeight": "0.95" },
        "mobile": { "fontSize": "48px", "lineHeight": "0.92" }
      },
      "h2": {
        "desktop": { "fontSize": "104px", "lineHeight": "1.15" },
        "laptop": { "fontSize": "66.56px", "lineHeight": "1.15" },
        "tablet": { "fontSize": "72px", "lineHeight": "1.10" },
        "mobile": { "fontSize": "48px", "lineHeight": "1.05" }
      },
      "bannerH1": {
        "desktop": { "fontSize": "64px", "lineHeight": "1.20" },
        "laptop": { "fontSize": "48px", "lineHeight": "1.20" },
        "tablet": { "fontSize": "44px", "lineHeight": "1.18" },
        "mobile": { "fontSize": "32px", "lineHeight": "1.15" }
      }
    }
  },
  "layout": {
    "paddingGlobal": {
      "mobile": "20px",
      "tablet": "36px",
      "desktop": "41px",
      "wide": "64px",
      "maxWidth": "1440px"
    },
    "bentoGrid": {
      "ratio1440": "545fr 727fr",
      "gap": "24px"
    }
  },
  "radii": {
    "button": "8px",
    "eyebrow": "14px",
    "cardDefault": "16px",
    "cardLarge": "24px",
    "sectionLip": {
      "mobile": "32px",
      "desktop": "64px"
    }
  },
  "motion": {
    "cubicDefault": "cubic-bezier(0.625, 0.05, 0, 1)",
    "smoothEase": "cubic-bezier(0.32, 0.72, 0, 1)",
    "buttonDuration": "0.55s",
    "drawerDuration": "500ms"
  }
}
