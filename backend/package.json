{
  "name": "school-management-backend",
  "version": "1.0.0",
  "description": "API RESTful Modular y Gateway WebSockets — Planteles de Aplicación 'Guamán Poma de Ayala' (UNSCH)",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "backfill:identities": "npm run build && node dist/scripts/backfill-identities.js",
    "bootstrap:admin": "npm run build && node dist/scripts/bootstrap-admin.js",
    "lint": "eslint src",
    "test": "npm run build && node --test tests/*.test.cjs",
    "test:integration": "npm run build && node --test tests/integration/*.test.cjs"
  },
  "dependencies": {
    "body-parser": "^1.20.9",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "^10.2.1",
    "pdfkit": "^0.17.2",
    "pg": "^8.12.0",
    "redis": "^4.6.14",
    "ws": "^8.22.0",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.14.9",
    "@types/nodemailer": "^7.0.12",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.11.6",
    "@types/ws": "^8.18.2",
    "@types/yauzl": "^2.10.3",
    "eslint": "^9.39.5",
    "school-contracts": "file:../packages/contracts",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.2",
    "typescript-eslint": "^8.72.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "private": true
}
